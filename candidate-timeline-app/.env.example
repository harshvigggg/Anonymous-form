# Leave everything empty to run in "this browser only" mode (good for trying the app).
# Fill these in on Vercel (Project → Settings → Environment Variables) to store data in a database.

# Database (Supabase project → Settings → API)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Passcode executives type to open /admin (required when the database is connected)
ADMIN_KEY=

# Set to "false" to switch off the public sample candidate at /candidate/demo
DEMO_ENABLED=true
